# 公共配置（所有环境共享）
# 环境专属配置放 .env.{NODE_ENV}（参考 .env.test.example / .env.production.example）

# 服务
PORT=3000
API_PREFIX=api

# JWT 三线密钥（密钥隔离防 token 串用；生产必须强随机，建议 openssl rand -hex 32）
# admin=后台 B 端 / app=C 端 / internal=内部 Job（token exchange）
JWT_ISS=kqw-server
JWT_ADMIN_SECRET=dev-admin-secret
JWT_ADMIN_EXPIRES=2h
JWT_APP_SECRET=dev-app-secret
JWT_APP_EXPIRES=2h
JWT_APP_REFRESH_DAYS=30
JWT_INTERNAL_SECRET=dev-internal-secret
JWT_INTERNAL_EXPIRES=15m

# 内部调用方凭证（token exchange）：clientId -> clientSecret（JSON）
INTERNAL_CLIENTS={"settlement-job":"REPLACE_WITH_STRONG_RANDOM"}

# 错误文案覆盖（可选）：JSON 对象，只覆盖指定错误码
# ERROR_MESSAGES={"40001":"部分参数有误，请检查后重新提交"}

# 数据库（dev 默认值，可被环境文件覆盖）
DATABASE_URL="mysql://admin:Admin%40123456@127.0.0.1:3306/super-sales-db"
REDIS_URL="redis://127.0.0.1:6379"
