# 生产环境配置（复制为 .env.production 使用；.env.production 已 gitignore）
# 切换：npm run start:prod（NODE_ENV=production）
# ⚠️ 生产密钥建议走 KMS / 环境变量注入，不要提交到代码库

# 服务
PORT=3000

# 数据库（主库；生产建议走内网地址 + 只读账号分离）
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/super-sales-db"
REDIS_URL="redis://:PASSWORD@HOST:6379/0"

# JWT（生产必须更换为强随机密钥）
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM
JWT_EXPIRES=2h
