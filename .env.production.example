# 生产环境配置（复制为 .env.production 使用；.env.production 已 gitignore）
# 切换：npm run start:prod（NODE_ENV=production）
# ⚠️ 生产密钥建议走 KMS / 环境变量注入，不要提交到代码库
# ⚠️ 缺失 JWT 密钥或仍为 dev 默认值时，服务拒绝启动（fail-fast）
# 生成强随机密钥：openssl rand -hex 32

# 服务
PORT=3000

# 数据库（主库；生产建议走内网地址 + 只读账号分离）
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/super-sales-db"
REDIS_URL="redis://:PASSWORD@HOST:6379/0"

# JWT 三线密钥（admin=后台 / app=C 端 / internal=内部 Job；三者必须不同）
JWT_ISS=kqw-server
JWT_ADMIN_SECRET=REPLACE_WITH_STRONG_RANDOM
JWT_ADMIN_EXPIRES=2h
JWT_APP_SECRET=REPLACE_WITH_STRONG_RANDOM
JWT_APP_EXPIRES=2h
JWT_APP_REFRESH_DAYS=30
JWT_INTERNAL_SECRET=REPLACE_WITH_STRONG_RANDOM
JWT_INTERNAL_EXPIRES=15m

# 内部调用方凭证（token exchange）：泄漏处置 = 更换对应 client 的 secret
INTERNAL_CLIENTS={"settlement-job":"REPLACE_WITH_STRONG_RANDOM"}
