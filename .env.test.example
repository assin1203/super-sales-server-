# 测试环境配置（复制为 .env.test 使用；.env.test 已 gitignore）
# 切换：npm run start:test（NODE_ENV=test）

# 测试库（独立库，避免污染 dev 数据）
DATABASE_URL="mysql://admin:Admin%40123456@127.0.0.1:3306/super-sales-db-test"
REDIS_URL="redis://127.0.0.1:6379/1"

# JWT（测试环境可用固定短密钥；注意与 dev 的 Redis 库号不同，refresh 缓存互不干扰）
JWT_ADMIN_SECRET=test-admin-secret
JWT_APP_SECRET=test-app-secret
JWT_INTERNAL_SECRET=test-internal-secret
JWT_INTERNAL_EXPIRES=15m
INTERNAL_CLIENTS={"settlement-job":"test-settlement-secret"}
