generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

model user {
  id                BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  phone             String    @unique(map: "uk_phone") @db.VarChar(20)
  password_hash     String?   @db.VarChar(128)
  nickname          String    @default("") @db.VarChar(64)
  avatar            String    @default("") @db.VarChar(255)
  invite_code       String    @unique(map: "uk_invite_code") @db.VarChar(16)
  referrer_id       BigInt?   @db.UnsignedBigInt
  level             Int       @default(0) @db.TinyInt
  level_updated_at  DateTime? @db.DateTime(0)
  ancestor_chain    Json?
  merchant_category String    @default("") @db.VarChar(64)
  store_info        Json?
  real_name_status  Int       @default(0) @db.TinyInt
  status            Int       @default(1) @db.TinyInt
  last_login_at     DateTime? @db.DateTime(0)
  created_at        DateTime  @default(now()) @db.DateTime(0)
  updated_at        DateTime  @default(now()) @db.DateTime(0)

  @@index([level], map: "idx_level")
  @@index([referrer_id], map: "idx_referrer")
  @@map("user")
}

model point_wallet {
  id             BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  user_id        BigInt   @unique(map: "uk_user") @db.UnsignedBigInt
  balance        BigInt   @default(0)
  frozen_balance BigInt   @default(0)
  total_earned   BigInt   @default(0)
  total_consumed BigInt   @default(0)
  version        Int      @default(0) @db.UnsignedInt
  created_at     DateTime @default(now()) @db.DateTime(0)
  updated_at     DateTime @default(now()) @updatedAt @db.DateTime(0)

  @@map("point_wallet")
}

model point_flow {
  id            BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  flow_no       String    @unique(map: "uk_flow_no") @db.VarChar(64)
  user_id       BigInt    @db.UnsignedBigInt
  delta         BigInt
  balance_after BigInt
  flow_type     String    @db.VarChar(32)
  biz_id        BigInt?   @db.UnsignedBigInt
  biz_no        String    @default("") @db.VarChar(64)
  rule_version  Int       @default(1)
  expire_at     DateTime? @db.DateTime(0)
  deferred_flag Int       @default(0) @db.TinyInt
  frozen        Int       @default(0) @db.TinyInt
  remark        String    @default("") @db.VarChar(255)
  created_at    DateTime  @default(now()) @db.DateTime(0)

  @@index([expire_at, frozen], map: "idx_expire")
  @@index([flow_type, biz_id], map: "idx_type_biz")
  @@index([user_id, created_at], map: "idx_user_time")
  @@map("point_flow")
}

model room {
  id               BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
